<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Small top app bar: title at the start, on the surface container (as when content scrolls under it). -->
    <style name="Npdf.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="titleTextAppearance">@style/TextAppearance.Material3.TitleLarge</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <!-- Navigation bar (home tabs and the reader's modes): Material 3 with the active indicator. -->
    <style name="Npdf.NavigationBar" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Npdf.ModeBar" parent="Npdf.NavigationBar" />

    <!-- Buttons, by Material 3 emphasis. -->
    <style name="Npdf.Button.Filled" parent="Widget.Material3.Button" />
    <style name="Npdf.Button.Tinted" parent="Widget.Material3.Button.TonalButton" />
    <style name="Npdf.Button.Gray" parent="Widget.Material3.Button.OutlinedButton" />
    <style name="Npdf.Button.Plain" parent="Widget.Material3.Button.TextButton" />

    <!-- Text styles used by layouts. -->
    <style name="Npdf.Text.Footnote" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Npdf.Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Npdf.Text.Subhead" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Npdf.Text.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Npdf.Text.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
